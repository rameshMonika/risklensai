# LLM provider: "groq" (default, local dev) or "azure" (Azure AI Foundry)
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key

# Azure AI Foundry (used when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-foundry-key
AZURE_OPENAI_DEPLOYMENT=gpt-oss-120b
AZURE_OPENAI_API_VERSION=2024-10-21

TAVILY_API_KEY=your-tavily-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Shared with the Core service (must match its INTERNAL_SERVICE_API_KEY exactly)
INTERNAL_SERVICE_API_KEY=change-me-to-a-long-random-string

# LangSmith tracing for the LangGraph pipeline. Set LANGSMITH_TRACING=false to
# run without a key. Get a key at https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=risklens-agent
